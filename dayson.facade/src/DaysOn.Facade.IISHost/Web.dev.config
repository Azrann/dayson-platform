<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="AuthServer" value="" xdt:Transform="Replace"></add>
  </appSettings>
  <log4net xdt:Transform="Replace">
    <root>
      <level value="ALL" />
      <appender-ref ref="GelfUdpAppender" />
      <appender-ref ref="rollingFile" />
    </root>
    <appender name="GelfUdpAppender" type="Gelf4net.Appender.GelfUdpAppender, Gelf4net">
      <remoteAddress value="172.25.128.5" />
      <remotePort value="12201" />
      <layout type="Gelf4net.Layout.GelfLayout, Gelf4net">
        <param name="AdditionalFields" value="app:Facade,version:1.0,Environment:Dev,Level:%level" />
        <param name="Facility" value="DaysOn.Facade" />
        <param name="IncludeLocationInformation" value="true" />
        <param name="ConversionPattern" value="[%t] %c{1} - %m" />
      </layout>
    </appender>
    <appender name="rollingFile" type="log4net.Appender.RollingFileAppender,log4net">
      <param name="File" type="" value="App_Data\logs\" />
      <param name="AppendToFile" value="true" />
      <param name="RollingStyle" value="Date" />
      <param name="DatePattern" value="yyyyMMdd'.txt'" />
      <param name="StaticLogFileName" value="false" />
      <param name="ImmediateFlush" value="true" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
  </log4net>
</configuration>