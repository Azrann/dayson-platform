<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <connectionStrings>
     <add name="NoSQL" connectionString="REPLACE_WITH_YOUR_VALUE" providerName="System.Data.SqlClient" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
     <add name="HolidaysDB" connectionString="REPLACE_WITH_YOUR_VALUE" providerName="System.Data.SqlClient" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
  <appSettings>
    <add key="Enviroment" value="PROD" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="Prefix" value="1234" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  </appSettings>
</configuration>